# 1. Cloudflare D1 Database Binding & REST Credentials
CF_ACCOUNT_ID=
CF_DATABASE_ID=
CF_DATABASE_NAME=ali-garments
CF_API_TOKEN=

# 2. Production Session Secret for Edge Authentication (HMAC-SHA256)
SESSION_SECRET=
